# SMTP – uitgaande e-mail (TransIP)
SMTP_HOST=smtp.transip.email
SMTP_PORT=465
SMTP_USER=your-smtp-login@example.com
SMTP_PASS=your-smtp-password
# Afzenderadres dat ontvangers zien (mag afwijken van SMTP_USER)
SMTP_FROM=info@medinapharmalabs.eu

# IMAP – inkomende e-mail (TransIP, ter referentie)
IMAP_HOST=imap.transip.email
IMAP_PORT=993
IMAP_USER=info@medinapharmalabs.eu
IMAP_PASS=your-imap-password
